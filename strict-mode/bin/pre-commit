#!/usr/bin/env bash
# STRICT-MODE:MANAGED-HOOK v3
set -euo pipefail
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GATE="$SCRIPT_DIR/strict-green-gate.sh"
if [ ! -x "$GATE" ] || [ ! -s "$SCRIPT_DIR/strict_gate.py" ]; then
  echo "strict-mode: installed gate is missing" >&2
  exit 1
fi
if [ "${1:-}" = "--caphe-probe" ]; then
  echo "caphe strict-mode hook active"
  exit 0
fi
# A caller-provided environment variable cannot replace the originally effective hook.
CAPHE_PREVIOUS_HOOK=''
if [ -f "$SCRIPT_DIR/.caphe-chain.sh" ]; then source "$SCRIPT_DIR/.caphe-chain.sh"; fi
if [ -n "$CAPHE_PREVIOUS_HOOK" ]; then "$CAPHE_PREVIOUS_HOOK" "$@"; fi
"$GATE" --mode affected
