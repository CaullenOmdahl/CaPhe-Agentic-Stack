{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "reference"
      ],
      "type": "object"
    },
    "display_contract": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "minItems": 1,
          "type": "array"
        },
        "intended": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "intended",
        "criteria"
      ],
      "type": "object"
    },
    "observations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "file",
              "url",
              "digest",
              "check"
            ]
          },
          "reference": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "reference"
        ],
        "type": "object"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "scope": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "visual"
              }
            }
          },
          "then": {
            "required": [
              "viewport"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hardware"
              }
            }
          },
          "then": {
            "required": [
              "device"
            ]
          }
        }
      ],
      "properties": {
        "device": {
          "additionalProperties": false,
          "properties": {
            "family": {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            "identifier": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "family",
            "identifier"
          ],
          "type": "object"
        },
        "kind": {
          "enum": [
            "visual",
            "hardware"
          ]
        },
        "viewport": {
          "additionalProperties": false,
          "properties": {
            "height": {
              "maximum": 32768,
              "minimum": 1,
              "type": "integer"
            },
            "width": {
              "maximum": 32768,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "width",
            "height"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "type": "string"
        },
        "revision": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "snapshot_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision",
        "snapshot_digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "source",
    "artifact",
    "display_contract",
    "scope",
    "observations"
  ],
  "title": "Semantic acceptance declaration, not verification",
  "type": "object"
}
