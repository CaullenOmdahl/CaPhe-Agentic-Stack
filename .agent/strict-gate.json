{
  "version": 1,
  "components": [
    {
      "name": "stack",
      "paths": [
        "**"
      ],
      "depends_on": [],
      "dependency_verification": {
        "kind": "single-component"
      },
      "commands": [
        {
          "name": "python-tests",
          "run": [
            "python3",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-v"
          ],
          "parallel_safe": true,
          "timeout_seconds": 600
        },
        {
          "name": "shell-syntax",
          "run": [
            "bash",
            "strict-mode/test/shell-syntax-test.sh"
          ],
          "parallel_safe": true,
          "timeout_seconds": 180
        },
        {
          "name": "strict-confer-isolation",
          "run": [
            "bash",
            "strict-mode/test/strict-confer-isolation-test.sh"
          ],
          "parallel_safe": true,
          "timeout_seconds": 180
        },
        {
          "name": "public-safety",
          "run": [
            "bash",
            "test/public-safety-test.sh"
          ],
          "parallel_safe": true,
          "timeout_seconds": 180
        }
      ]
    }
  ]
}
